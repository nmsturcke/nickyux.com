function animateStartup() {
    const timeline = gsap.timeline();

    timeline.from(".text-supertitle.self-end", {
        marginRight: "80vw",
        duration: 2,
        ease: "power3.out",
        delay: 0.5
    });
    timeline.from(".text-title:not(.after)", {
        y: 100,
        opacity: 0,
        duration: 1.5,
        ease: "power3.out"
    }, "-=1.5");
    timeline.to(".text-supertitle", {
        maxHeight: "0px",
        opacity: 0,
        duration: 1,
        ease: "power3.inOut",
        delay: 0.5
    }, "goUp");
    timeline.to(".text-title:not(.after)", {
        y: -1000,
        opacity: 0,
        duration: 1,
        ease: "power3.in",
    });
    timeline.to("div:has(> .text-title:not(.after))", {
        maxHeight: "0px",
        duration: 0.5,
        ease: "power3.inOut"
    }, "goUp+=2.5");
    timeline.from("div:has(> .text-title.after)", {
        y: 0,
        opacity: 0,
        transform: "scale(1, 5)",
        duration: 1.5,
        ease: "power3.out"
    }, "goUp+=0.5");
}

animateStartup();
